# =====================================================================
#  알람 / 메일 알림 설정
#    사용 : scripts/daq-notify.sh --params config/notify.params <이벤트> ...
#           scripts/daq-alarm.sh  --params config/notify.params --raise '...'
#           scripts/usb-recover.sh --params config/notify.params
#           install/bin/rcsupervisor --notify-cmd scripts/daq-notify.sh
#    형식 : 'key = value'  ( '#' 뒤는 주석 )
#
#  ★ 이 파일에는 비밀번호가 들어간다. config/notify.params 는 .gitignore 대상이다.
#    복사해서 쓸 것 :  cp config/notify.params.example config/notify.params
#                      chmod 600 config/notify.params
#
#  ★ 값 안에 '#' 을 쓰지 말 것. 파서가 주석으로 보고 잘라낸다.
#    앱 비밀번호에 '#' 이 들어 있으면 새로 발급받는 편이 빠르다.
# =====================================================================

# ---- 알람 (현장에서 귀로 듣는 것) ------------------------------------
#  both   = 사운드카드 + PC 스피커 둘 다   <- 권장. 한쪽이 죽어도 남는다
#  card   = 사운드카드만 (외부 스피커)
#  pcspkr = 케이스 내부 비프만
#  none   = 소리 없이 화면·로그만
alarm_sound     = both

#  1 이면 사람이 끌 때까지 계속 울린다 :  scripts/daq-alarm.sh --silence
#  0 이면 alarm_max_sec 만큼만 울리고 스스로 멈춘다.
alarm_until_ack = 1
alarm_period    = 20        # 경보음 반복 간격 [초]
alarm_max_sec   = 600       # alarm_until_ack = 0 일 때만 쓰인다
alarm_device    = default   # aplay -D 에 넘길 장치. 보통 default 로 둔다
alarm_volume    = 90        # 경보 직전 Master 를 이 값[%]으로 올린다. 0 이면 건드리지 않는다

#  알람 상태 파일. 이것이 있으면 알람이 울리는 중이다.
#  rcmon.sh 와 daq-tmux.sh 가 화면에 배너를 띄울 때도 이 파일을 본다.
alarm_state     = /Data/LOG/daq-alarm.state

# ---- 메일 -----------------------------------------------------------
mail_enable     = 1
smtp_host       = smtp.gmail.com
smtp_port       = 587
smtp_security   = starttls    # starttls | ssl | none
smtp_user       =             # 보내는 계정 (Gmail 이면 전체 주소)
smtp_pass       =             # ★ 앱 비밀번호. 계정 비밀번호가 아니다.
                              #   Gmail 은 계정 비밀번호로 SMTP 를 받지 않는다
                              #   (535 5.7.8). 2단계 인증을 켠 뒤 발급받는다.
                              #   구글이 보여주는 대로 띄어 써도 된다 -- 공백은 걷어낸다
mail_from       =             # 비우면 smtp_user 를 쓴다

#  책임자 — 일상 알림(재시작·stale·복구 성공)을 받는다. 쉼표로 여러 명.
mail_to         =
#  전문가 — 자동 복구가 실패해 사람이 현장에 가야 할 때 받는다.
#           비우면 mail_to 와 같은 곳으로 간다.
mail_to_expert  =

mail_subject_prefix = [RENE DAQ]

# ---- 어떤 사건에 무엇을 할까 ----------------------------------------
#  값 : none | mail | alarm | both
#
#   restart          런 하나가 실패해 감시자가 재시작했다
#   stale            런이 쓰기 도중 멈춰(heartbeat 정지) 감시자가 개입했다
#   recovered        연속 실패 뒤 usbreset 자동 복구에 성공했다
#   recovery_failed  자동 복구가 끝내 안 됐다.  ★ 사람이 현장에 가야 한다
#   fatal            감시자가 포기하고 종료한다
on_restart          = mail
on_stale            = mail
on_recovered        = mail
on_recovery_failed  = both
on_fatal            = both
#   backup_audit     로컬과 경희대를 대조한 결과 (scripts/backup-audit.sh --mail)
#                    급한 것이 아니므로 소리는 내지 않는다
on_backup_audit     = mail
on_sheetlog         = mail
#   chain_down       후처리 사슬이 끊겼다 (scripts/chainwatch.sh)
#                    /scratch 마운트 · postrun · dataflow 중 하나가 없다.
#                    수집은 계속되므로 급하지는 않다 -- 다만 두면 SSD 가 찬다
#   rate_low         수집은 도는데 ADC 별 계수율이 문턱 아래다
#                    ★ 데이터가 지금 이 순간 비어 가는 중이다. 현장이 무인이면
#                      both 로 올리는 것을 권한다
on_chain_down       = mail
on_rate_low         = mail
on_rate_high        = both      # ★ ADC 별 계수율 30,000 Hz 이상 (잡음 트리거) : 알람 + 책임자 메일 (2026-09-14 사용자 지시)
on_rotate           = mail      # 정상 런 교체. 책임자에게만 (아래 목록에 넣지 말 것)
on_resumed          = mail      # 문제 뒤 다시 정상 가동
on_backup_session   = mail      # 저장소 백업 세션 시작/종료 (새 판인지 포함). 책임자만
on_websummary       = mail      # 런 서머리 웹 발행이 막혔다 (단계 실패·대조 불일치). 같은 사유로는 한 번만. 책임자만
on_supervisor_down  = both      # ★ 감시자가 FATAL 로 끝났다 (chainwatch). 알람 + 메일. 아래 목록에 넣어 전문가에게도
on_disk_low         = mail      # /Data_ssd 여유가 문턱 아래 (chainwatch). 알람 문턱 아래면 알람도 함께 온다
on_mid_disk_low     = mail      # /data 여유가 문턱 아래 (같은 규칙, 사건명만 따로 -- 도배 방지에 서로 먹히지 않게)
on_standby_retry    = none      # 감시자 대기(standby) 중 재시도 (시간당 1 회, 하루 24 통 가능). 기본 로그만. 받으려면 mail
on_net_down         = mail      # 바깥 망 단절 (netsync). 큐에 들어가 복귀 뒤에 나간다
on_net_restored     = mail      # 바깥 망 복귀 -- 밀린 메일·시트를 내보낸 결과
mail_queue          = /Data_ssd/LOG/MAILQ   # 못 보낸 메일을 쌓는 곳. mailq-send.sh 가 비운다

#  누구에게 가나 (2026-09-09 사용자 지시).  여기 적힌 사건은 전문가 목록 + 책임자,
#  나머지는 책임자만.  비워 두면 예전 규칙(recovery_failed · fatal 만 전문가).
mail_expert_events  = restart stale recovered recovery_failed fatal chain_down rate_low resumed supervisor_down disk_low mid_disk_low

#  같은 이벤트를 이 간격 안에 여러 번 보내지 않는다 [초]. 도배 방지.
#  recovery_failed 와 fatal 은 이 제한을 받지 않는다 (놓치면 안 되는 것들이다).
mail_min_interval   = 300

# ---- 자동 USB 복구 --------------------------------------------------
#  감시자가 연속 실패 한계(--max-consec-fail, 기본 5)에 닿았을 때
#  포기하기 전에 scripts/usb-recover.sh 를 한 번 부른다.
#  순서 : 진단 -> [usbreset 2 회 연속 + 확인 런] x recover_max_try -> (안 되면) PDU 전원 재투입
recover_enable      = 1
recover_max_try     = 3       # usbreset 단계 시도 수. 시도마다 고아 정리 + usbreset 2 회 연속 + 확인 런
recover_resets_per_try = 2    # 시도당 usbreset 횟수 (2~3 회째에 DRAM 이 맞았다, §11.130·171·224·225)
recover_settle_sec  = 15      # 리셋 뒤 보드가 다시 잡힐 때까지 기다리는 시간 [초]
recover_check_min   = 0.05    # 확인 런 길이 [시간]. 0.05 = 3분
recover_check_run   = 999999  # 확인 런에 쓸 번호. 카탈로그를 더럽히지 않으려고 --no-db 로 돈다
recover_check_params =        # 확인 런 rcterm params. 비우면 config/rcterm.params
                              # (낮에 포화하는 설정이면 낮은 문턱의 다른 파일을 줄 것, §11.227)
recover_min_rate    = 500     # 확인 런의 ADC 별 계수율 최솟값이 이 [Hz] 이상이어야 정상
                              # ★ 합이 아니라 최솟값을 본다. 한 보드만 죽으면 합·평균은 멀쩡해 보인다
                              # ★ 운영 값은 100 (2026-09-14 veto 문턱 조정 뒤 정상 ~300 Hz, §11.196)
recover_max_rate    = 20000   # 최댓값이 이 [Hz] 를 넘으면 불합격 (설정 소실 23,527 Hz · 포화 42 kHz)
recover_log_age_min = 60      # rcterm.log 의 'booting run' 줄과 dmesg 를 최근 이 [분] 만큼 본다.
                              # 그 런들의 DAQ 로그는 /Data_ssd/LOG -> /scratch/DAQ_LOG/RAW_log{,.old*} 에서 찾는다
recover_scan_runs   = 6       # 최근 실패 런을 몇 개까지 볼까
recover_keep_data   = 0       # 1 이면 확인 런의 파일을 남긴다. 0 이면 지운다
#  ★ 전원 재투입 단계 (§11.224 순서, 2026-11-05 사용자 결정 : 완전 자동화)
#    killdaq -> pdu-power.sh cycle --allow-supervisor -> 보드 3 종 90 s -> NOTICE_CODE_RUN.sh
#    -> usbreset 2 회 -> 10 s 더미 런 -> 확인 런 (실패하면 usbreset 1 회 + 확인 런 2 회 더)
#    config/pdu.params (0600) 가 있어야 한다. 키가 없으면 0 = 하지 않는다
recover_power_cycle = 1
recover_power_max   = 2       # recover_power_window_h 시간에 최대 몇 번 (복구 호출당은 언제나 1 번)
recover_power_window_h = 6
recover_power_state = /Data_ssd/LOG/usb-recover.power.state   # 한 줄 = 한 번 (epoch 시각)
recover_notice_timeout = 120  # NOTICE_CODE_RUN.sh 제한 [s]. TCB 가 멈추면 출력 없이 매달린다 (§11.225)

# ---- 후처리 사슬 감시 (scripts/chainwatch.sh) ------------------------
#  cron 이 5분마다 부른다 :
#     */5 * * * * <저장소>/scripts/chainwatch.sh >/dev/null 2>&1
#  상태만 보려면 (읽기 전용) :  scripts/chainwatch.sh --status
#
#  ★ tmux 세션 'daq' 도 없고 감시자도 없으면 아무 말도 하지 않는다.
#    사람이 일부러 세운 것을 고장으로 알리지 않기 위해서다.
chain_nfs_root      = /scratch   # 이것이 마운트돼 있어야 postrun 이 돈다
chain_min_rate      = 100        # ADC 별 계수율 최솟값의 문턱 [Hz]. 2026-09-14 veto 문턱 조정 뒤 정상은 ~300 Hz
chain_warn_rate     = 20000      # ★ ADC 별 계수율 최댓값이 이 이상이면 경고 문구만 (로그 · --status · rcmon 화면)
chain_alarm_rate    = 30000      # ★ 이 이상이면 rate_high = 알람 + 책임자 메일, 연속 조건 없이 즉시 (2026-09-14 사용자 지시)
                                 # ★ 합이 아니라 최솟값이다. 한 보드만 죽으면
                                 #   합·평균은 멀쩡해 보인다
chain_consecutive   = 2          # 이만큼 연속으로 이상이어야 알린다 (흔들림 무시)
chain_warmup_sec    = 180        # 런 시작 후 이 시간[초] 안에는 계수율을 보지 않는다
                                 # 부팅 직후에는 정상적으로 0 으로 나온다
chain_realert_min   = 60         # 이상이 이어질 때 다시 알리는 간격 [분]
chain_hb_max_age    = 120        # heartbeat 가 이보다 오래되면 '수집 중이 아니다'
                                 # 로 보고 계수율을 판정하지 않는다
                                 # ★ 계수율은 heartbeat 의 순간값 sr= 로 본다 (없으면 평균 ar=). 2026-11-05
chain_rate_stop     = 1          # rate_high 때 감시자에 SIGUSR1 = 현재 런 정상 마감 뒤 cooldown 재기동. 런당 한 번
                                 # 감시자가 SIGUSR1 을 처리하는 판일 때만 보낸다 (/proc/<pid>/status 의 SigCgt)
chain_min_free_gb   = 700        # /Data_ssd 여유가 이보다 적으면 disk_low 메일 (dataflow 의 min_free_gb 와 같은 뜻)
chain_disk_alarm_gb = 200        # 이보다 적으면 알람 + 메일
chain_mid_min_free_gb = 3000     # /data 여유 문턱 (메일)
chain_mid_alarm_gb  = 500        # /data 알람 문턱
chain_sup_autorestart = 1        # 감시자가 FATAL 로 끝났으면 supervisor pane 에서 다시 띄운다 (시간당 1 회)
chain_sup_autorestart_daily = 3  # 하루 상한. 보드가 정말 죽었으면 재기동마다 런 번호 5 개를 태운다
chain_autorestart   = 1          # postrun · dataflow 가 죽었으면 그 pane 에서 다시 띄운다 (시간당 1 회)
                                 # postrun 은 /scratch 가 있을 때만. dataflow 는 자체 마운트 가드가 있어 늘
chain_sup_restart_after_min = 30 # 감시자가 끝난 뒤(FATAL 또는 stop 줄 없이 사라짐) 이만큼 지나야 다시 띄운다
chain_sup_standby_max_age = 900  # 감시자 대기 상태 파일(<heartbeat>.sup 의 time=)이 이보다 오래되면 믿지 않는다
chain_sup_restart_manual = 0     # 1 이면 사람이 TERM 으로 세운 감시자('rcsupervisor stop')도 chain_sup_restart_after_min 뒤 다시 띄운다 (수집을 늘 돌릴 때).
                                 #   ★ 일부러 세워 두려면 touch <chain_hold_file> (끝나면 rm). 감시자를 TERM 하는 손 작업(usbreset·전원·문턱 변경)은 먼저 hold 를 만들 것.
                                 #   --max-cycles · --dry-run 으로 스스로 끝난 감시자(시험 런)는 되살리지 않는다. 알림은 없고(하루 상한에 닿으면 1 통), 다시 뜨면 런 교체(resumed) 메일이 간다
chain_hold_file     = /Data_ssd/LOG/chainwatch.hold   # ★ 이 파일이 있으면 pane 자동 재기동 안 함 (알림은 나감)
                                 # 사람이 손으로 작업할 때 :  touch … 하고, 끝나면 rm …
#  pane 에 넣는 명령은 scripts/daq-tmux.sh --print-cmd supervisor|postrun|dataflow 가 찍는 줄 그대로다

# ---- 바깥 망 감시 (scripts/netsync.sh, cron */5) ----------------------
#  키는 없다. 환경변수 NETSYNC_DOWN_CONSEC(기본 2) · NETSYNC_FRESH_SEC(기본 900) 로만 바꾼다.
