# ---------------------------------------------------------------------
#  ~/.dircolors  -  ls 색상표 (어두운 배경 기준)
#
#  ~/.bashrc 가 이미 이 파일을 자동으로 읽는다:
#      test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)"
#  바꾼 뒤에는 새 셸을 열거나  eval "$(dircolors -b ~/.dircolors)"  실행.
#
#  설계 원칙
#   * 종류마다 '색' 뿐 아니라 '글자 속성'도 다르게 준다.
#     디렉터리=굵게, 심볼릭링크=밑줄, 임시/빌드산출물=흐리게.
#     색을 구분하기 어려운 상황에서도 형태로 구분된다.
#   * 256색 번호(38;5;N)를 직접 쓴다. 터미널 16색 팔레트의 파랑이
#     #12488b 같은 짙은 남색이어도 영향받지 않는다.
#     ※ tmux 안에서 256색이 되려면 ~/.tmux.conf 의
#       default-terminal "tmux-256color" 가 필요하다.
#   * 일반 파일은 색을 주지 않는다(00). 터미널 전경색을 그대로 쓰므로
#     배경이 밝든 어둡든 항상 읽힌다.
# ---------------------------------------------------------------------

TERM ansi
TERM *color*
TERM con[0-9]*x[0-9]*
TERM cons25
TERM console
TERM cygwin
TERM dtterm
TERM eterm*
TERM gnome*
TERM hurd
TERM jfbterm
TERM konsole
TERM kterm
TERM linux
TERM linux-c
TERM mlterm
TERM putty*
TERM rxvt*
TERM screen*
TERM st
TERM st-*
TERM terminator
TERM tmux*
TERM vt100
TERM xterm*

# ---- 기본 ----
RESET      0
NORMAL     00
FILE       00
MULTIHARDLINK 00

# ---- 디렉터리 : 굵은 하늘색. 짙은 남색(#12488b) 문제를 우회한다 ----
DIR        01;38;5;117

# ---- 심볼릭 링크 : 밑줄 + 청록. 밑줄이 있으면 색맹이어도 구분된다 ----
LINK       04;38;5;123
ORPHAN     01;38;5;196;48;5;52
MISSING    01;38;5;196;48;5;52

# ---- 실행 파일 : 굵은 초록 ----
EXEC       01;38;5;155

# ---- 특수 파일 ----
FIFO       38;5;227;48;5;235
SOCK       01;38;5;177
DOOR       01;38;5;177
BLK        01;38;5;220;48;5;235
CHR        38;5;227;48;5;235

# ---- 권한 이상 : 눈에 띄어야 한다 ----
SETUID     01;38;5;231;48;5;124
SETGID     01;38;5;16;48;5;220
CAPABILITY 01;38;5;231;48;5;124

# ---- 누구나 쓸 수 있는 디렉터리 ----
#  기본값은 초록 바탕에 파란 글씨(34;42)라 거의 읽을 수 없다.
#  디렉터리 색을 유지하되 밑줄로 "열려 있음"을 표시한다.
#  이 사이트에서는 /Data_ssd 가 여기 해당한다(drwxrwxrwx).
STICKY_OTHER_WRITABLE 01;04;38;5;117
OTHER_WRITABLE        01;04;38;5;117
STICKY                01;38;5;117

