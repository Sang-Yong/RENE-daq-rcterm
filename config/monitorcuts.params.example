# monitorcuts.params - 모니터링 지표(BuildMetrics.C)의 컷 손잡이.
#   쓰는 법 : cp config/monitorcuts.params.example config/monitorcuts.params
#             (실제 파일은 .gitignore 대상이다. 사이트마다 다를 수 있어서다)
#   읽는 곳 : tools/monitor/metrics.sh -> BuildMetrics.C 의 매크로 인자
#   형식    : 'key = value' 한 줄. '#' 뒤는 주석. 같은 키가 여러 번이면 나중 것.
#
# 새 지표(예비)의 손잡이. ★ 분석팀 검증 전까지 웹에 '(예비)' 로 표시된다.
mu_shower_npe = 3000    # 이 NPE 초과 target 뮤온을 '샤워링' 으로 본다 ★미검증
lihe_fit_lo_s = 0.002   # Li/He 적합 창 [s]
lihe_fit_hi_s = 10.0
lihe_min_cand = 100     # 이보다 후보가 적으면 적합하지 않는다 (lowstat)
fn_e_lo_mev   = 12.0    # fast-n prompt 사이드밴드 [MeV] ★미검증
fn_e_hi_mev   = 50.0
fn_tag_s      = 0.1     # 직전 샤워링 뮤온에서 이 시간 안의 후보 수 = n_fn_mutag

# ---- IBD 컷 오버라이드 (스펙 §4 '컷 변경 = DST 초 단위 재계산') ----
# 주석을 풀면 AnalysisCondition.h 대신 이 값을 쓴다. ★ 하나라도 풀면
# metrics.sh --verify 가 거부한다 (legacy 와 컷이 달라 대조가 무의미).
# dt_max_us   = 120
# s2_lo_mev   = 5.5
# s2_hi_mev   = 10.5
# iso_pre_us  = 200
# iso_post_us = 400
#
# 쓸 수 있는 키는 10종이고 PairWindows 의 멤버와 1:1 이다 :
#   s1_lo_npe  s1_hi_npe  s2_lo_mev  s2_hi_mev  dt_min_us  dt_max_us
#   dt_acci_us  iso_pre_us  iso_post_us  lower_npe
#
# ★ *_mev 는 _NPE_MEV(508.818 NPE/MeV) 를 곱해 NPE 로 바꾼다. 분석 쪽 기본값은
#   비선형 MeVToNpe() 로 만들어지므로, 같은 MeV 숫자를 적어도 기본값과 똑같은
#   창이 되지 않는다 (6 MeV : 기본 3632 NPE 대 오버라이드 3053 NPE).
#   오버라이드는 '기본값을 다시 적는 것' 이 아니라 '다른 창으로 갈아 끼우는
#   것' 이다. 적용된 실효값은 metrics_summary.tsv 의 컷 열에 그대로 적히므로,
#   나중에 표만 보고도 어떤 컷의 결과인지 알 수 있다.
