# monitorcuts.params - 모니터링 지표(BuildMetrics.C)의 컷 손잡이.
#   쓰는 법 : cp config/monitorcuts.params.example config/monitorcuts.params
#             (실제 파일은 .gitignore 대상이다. 사이트마다 다를 수 있어서다)
#   읽는 곳 : tools/monitor/metrics.sh -> BuildMetrics.C 의 매크로 인자
#   형식    : 'key = value' 한 줄. '#' 뒤는 주석. 같은 키가 여러 번이면 나중 것.
#
# 배경 레시피 v2 (2026-09-08, docs/superpowers/specs/2026-09-08-background-recipes-v2-design.md)
# ★ 분석팀 검증 전까지 웹에 '(예비)' 로 표시된다.
#
# ---- Li/He : 직전 샤워링 뮤온까지의 시간 분포를 Daya Bay Eq.2 로 적합 ----
mu_shower_npe = 20000   # 이 NPE 초과 target 뮤온을 '샤워링' 으로 본다.
                        #   뜻은 에너지가 아니라 **rate 손잡이** 다 -- 적분창 1 µs 라
                        #   NPE 가 5만을 못 넘는다. run 4305 실측 : 3000 -> 1.33 Hz(1/R
                        #   0.75 s, τ_Li 0.257 s 와 축퇴), 20000 -> 0.63 Hz(1/R 1.6 s).
                        #   R_μ 가 1/τ_Li 의 2 배 안이면 lihe_stat=degen 으로 낸다
lihe_fit_lo_s = 0.002   # 적합 창 [s]. 첫 빈 중심(0.025 s)보다 작으면 아무 빈도 안 뺀다
lihe_fit_hi_s = 10.0
lihe_min_cand = 50      # 창 안 표본이 이보다 적으면 적합하지 않는다 (lowstat). 24h 런의 n-Gd 후보가 ~80 이라 100 이면 늘 lowstat
lihe_li_frac  = 1.0     # ⁹Li 분율 R (Eq.2). 1.0 = ⁹Li 만. 이 통계로는 띄울 수 없어 고정
#
# ---- fast-n : prompt 창을 사이드밴드로 올린 페어링을 0차·1차 외삽 ----
fn_e_lo_mev   = 12.0    # 사이드밴드 [MeV]. S1 신호창 상한(12)과 같으면 경계 사건이 양쪽에 든다
fn_e_hi_mev   = 50.0    #   ★ 12 MeV 이상은 실측 93 % 가 포화 -> T_Sat 을 합쳐 센다 (schema 2 DST)
#
# ---- PSD : 1-3 MeV single 의 꼬리비율 γ-band 에서 몇 σ 밖을 n-like 로 세나 ----
psd_nsig      = 3.0     # NEOS 는 p_psd > 3.5 를 기각. 여기서는 분리력이 약해(FoM 0.5) 추이용

# ---- IBD 컷 오버라이드 (스펙 §4 '컷 변경 = DST 초 단위 재계산') ----
# 주석을 풀면 AnalysisCondition.h 대신 이 값을 쓴다. ★ 하나라도 풀면
# metrics.sh --verify 가 거부한다 (legacy 와 컷이 달라 대조가 무의미).
# dt_max_us   = 120
# s2_lo_mev   = 5.5
# s2_hi_mev   = 10.5
# iso_pre_us  = 200
# iso_post_us = 400
#
# 쓸 수 있는 키는 10종이고 PairWindows 의 멤버와 1:1 이다 :
#   s1_lo_npe  s1_hi_npe  s2_lo_mev  s2_hi_mev  dt_min_us  dt_max_us
#   dt_acci_us  iso_pre_us  iso_post_us  lower_npe
#
# ★ *_mev 는 분석 헤더 자신의 MeVToNpe() 로 NPE 가 된다. 창 상수를 만든 바로
#   그 함수라(AnalysisCondition.h : S2_MIN_NPE = MeVToNpe(6)), 's2_lo_mev = 6'
#   은 기본 창을 정확히 되살린다. 적용된 실효값은 metrics_summary.tsv 의 컷
#   열에 MeV 로 적히므로, 나중에 표만 보고도 어떤 컷의 결과인지 알 수 있다.

# ---- 날짜 기준 단계(daily.sh → BuildDaily.C) 만의 손잡이 (2026-09-14) ----
#   metrics.sh 는 이 키들을 읽지 않는다. 런별 지표는 그대로다.
daily_psd_nsig = -1     # > 0 이면 prompt 의 p_psd = (꼬리비율 − m_γ(E))/σ_γ(E) 가 이 값을 넘는 쌍을 버린다 (on/off 같이).
                        #   γ 수용 3σ 에서 99.9 %. -1 = 끔. 그림 49/50 이 on/off 의 p_psd 분포와 컷 선을 보여 준다
fn_norm_mode   = 0      # fast-n 의 평평한 높이를 무엇으로 정하나.
                        #   0 = 사이드밴드 [fn_e_lo, fn_e_hi] 의 0차 외삽 (BuildMetrics 와 같다. ★ 사이드밴드는 실측 93 % 가
                        #       포화 사건이라 에너지가 잘려 있고, 새는 뮤온이 섞여 신호창으로 평평하게 외삽하면 과대 추정된다)
                        #   1 = 신호창 안 고에너지 꼬리 [fn_norm_lo_mev, S1 상한] 의 우발 뺀 on-window 쌍 수로 규격화.
                        #       IBD prompt 는 ~8 MeV 에서 끝나므로 그 위는 fast-n (+ Li/He 조금) 뿐이다
fn_norm_lo_mev = 8.5
mu_veto_us     = 0      # > 150 이면 prompt 가 어느 veto 뮤온이든 그 뒤 이 µs 안일 때 쌍을 버린다 (DST 의 150 µs 를 늘리는 것).
                        #   라이브타임을 exp(−R_μ·(값−150 µs)) 로 줄여 센다. R_μ ≈ 0.8 kHz 라 300 µs 면 12 % 를 더 잃는다
shower_veto_ms = 0      # > 0 이면 샤워링 뮤온(mu_shower_npe) 뒤 이 ms 안의 쌍을 버린다 (⁹Li/⁸He 직접 제거. Li/He 적합 창 아래끝도 이 값으로)
dst_subdir     = dst    # 4d(daily.sh) 가 읽을 DST 폴더. dst = 분석 코드의 패널 AND veto. dst_m2 = 강한 veto (dst-build.sh --muon-mode 2 :
                        #   veto PMT 하나라도 트리거 또는 S_ADC > 50 이면 뮤온, 150 µs 데드). websummary 가 새 런마다 같은 판을 만든다
daily_iso_pre_us  = -1  # 4d 만. > 0 이면 multiplicity 창(prompt 앞 / delayed 뒤)을 이 µs 로. 기본 -1 = AnalysisCondition.h 의 200/400 (n-H 600/1000).
daily_iso_post_us = -1  #   다중중성자 가족을 더 걸러내려면 1000/1000 쯤 (single 88 Hz × 2 ms ≈ 16 % 손실). 효과는 그림 53~56 으로 본다
metrics_dst_subdir = dst   # 런별 지표(metrics.sh → metrics_summary.tsv, 추이 18~28·59, 웹 표)가 읽을 DST 폴더. dst_m2 로 두면 런별도 강한 veto
                        #   (2026-09-15 사용자 지시). dst 가 아니면 legacy(PRD 재독, 패널 AND veto) 와의 대조(--verify) 는 뜻이 없어 건너뛴다
daily_prompt_lo_mev = -1   # 4d 만. 원자로 참조 신호창 [MeV] : 후보 수(n_cand_win · rate_win, 그림 60~63)를 이 prompt 창으로 센다. -1 = S1 창(1.2~12).
daily_prompt_hi_mev = -1   #   근거 : 원자로 ν̄ IBD prompt 스펙트럼(Daya Bay PRL 116 061801 · RENO PRL 116 211801)은 3~4 MeV 에서 최대, 8 MeV 위는 ~1 %.
                        #   실측 잔여 '신호' 는 1.2~2.8 MeV(n-H 2.2 MeV 포획 γ + 그 Compton) 와 7.6~9.4 MeV(n-Gd 8 MeV) 에만 있고 3~7 MeV 는 비어 있다
                        #   = 두 중성자 가족. 3.0 / 7.0 으로 두면 그 둘을 창 밖으로 내고 IBD 효율 ~0.6 을 남긴다 (템플릿 효율은 그림 60/61 에 찍힌다)
