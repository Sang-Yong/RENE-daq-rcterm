# =====================================================================
#  rcsupervisor parameter file
#    사용 : rcsupervisor --params config/rcsupervisor.params
#
#  이 프로그램은 rcterm 을 자식으로 띄우고,
#    - run-length 마다 런을 정상 종료시키고 새 run 번호로 다시 띄운다
#    - check-period 마다 이상 여부를 진단하여 이상이면 복구한다
# =====================================================================

# ---- 자식 프로그램 ----
rcterm        = /home/frontend/DAQ/RENE-daq-rcterm/install/bin/rcterm
rcterm-params = /home/frontend/DAQ/RENE-daq-rcterm/config/rcterm.params

# ---- 런 로테이션 ----
run-length    = 24            # 런 교체 주기 [시간]
margin        = 30            # rcterm 자체 타이머에 줄 여유 [분]
                              #  -> rcterm 은 24.5h 로 띄고, 24h 지점에
                              #     감시자가 SIGTERM 을 보내 마감을 지시한다.
max-cycles    = 0             # 0 = 무한 반복

# ---- 에러 감시 ----
check-period  = 600           # 진단 주기 [초]  (10분)
stale-limit   = 300           # heartbeat 가 이 시간 이상 안 바뀌면 이상
boot-grace    = 300           # 기동 구간은 진단 유예 [초]
stall-grace   = 1800          # 이벤트가 이 시간 동안 증가 안하면 이상 [초]
# no-stall-check              # 저리드 런이라 오랫동안 0 Hz 가 정상이면 해제
# no-socket-check             # TCB 직접 조회를 생략하고 heartbeat 만 볼 때

# ---- 복구 동작 ----
grace         = 180           # SIGTERM 후 정상종료 대기 [초]
settle        = 10            # 정리 후 대기 [초]
backoff       = 30            # 실패 후 대기 [초]
max-consec-fail = 5           # 연속 실패 한계 (닿으면 복구 시도, 안 되면 대기-재시도)

# ---- 경로 / 사이트 ----
heartbeat     = /Data/LOG/rcterm.hb       # rcterm.params 와 반드시 동일하게!
log           = /Data/LOG/rcsupervisor.log
bindir        = /home/frontend/DAQ/DAQ_cup/install/bin   # 정리용
daqserver     = localhost
daqport       = 7809

# ---- DB 를 사용하지 않을 때만 ----
# no-db
# run         = 1000          # 감시자가 사이클당 +1 시킨다

# ---- 알람 / 메일 / 자동 USB 복구  (2026-08-20 추가) ------------------
#  연속 실패 한계(max-consec-fail)에 닿으면 감시자는 포기하기 전에
#  recover-cmd 를 한 번 부른다. 그것이 종료코드 0 을 주면 실패 카운터를
#  0 으로 되돌리고 수집을 이어간다.
#
#  * 경로는 절대경로로 적을 것. 감시자의 작업 디렉터리와 무관하게 돌아야 한다.
#  * 사건별로 무엇을 할지(알람/메일)는 여기가 아니라 config/notify.params 가 정한다.
#  * 알람만 쓰고 자동 복구는 원치 않으면 no-auto-recover 의 주석을 푼다.
notify-cmd    = /home/frontend/DAQ/RENE-daq-rcterm/scripts/daq-notify.sh
notify-params = /home/frontend/DAQ/RENE-daq-rcterm/config/notify.params
recover-cmd   = /home/frontend/DAQ/RENE-daq-rcterm/scripts/usb-recover.sh
# no-notify                   # 알림을 아예 끈다
# no-auto-recover             # usbreset 자동 시도를 끈다 (알림은 그대로)

# ---- 자율 복구 (2026-11-05 추가) --------------------------------------
#  사람 손 없이 돈다. 감시자는 포기(FATAL)하지 않고 대기-재시도(standby)로 남는다.
#  대기 중에는 heartbeat 를 phase=standby (pid = 감시자) 로 쓴다. SIGTERM 으로만 멈춘다.
#  SIGUSR1 = 지금 런을 정상 마감하고 rate-cooldown 뒤 재기동 (chainwatch 가 보낸다).
standby-retry-min = 60        # 대기 중 재시도 주기 [분]
                              #  config(exit 1) : rcterm --dry-run 이 통과하면 재개
                              #  hardware       : recover-cmd 0 이면 재개, 1 이면 확인 런 1 개
                              #  rate           : 확인 런 1 개
# no-standby                  # 옛 동작 : 설정 오류 exit 1 / 한도 exit 2 로 감시자 종료
# no-early-recover            # USB 서명이 있어도 max-consec-fail 까지 기다린다
dram-check    = 1             # 부팅 뒤 TCB_<run>.log 의 'is aligned' 줄을 센다 (11.208)
dram-lines    = 8             #  이만큼 + 'Fail to align' 0 이어야 정상. 아니면 마감 -> recover
rate-poll     = 30            # heartbeat sr= 를 읽는 주기 [초]
max-rate      = 30000         # ADC 별 순간 계수율 상한 [Hz]. 0 = 끔  (ar 이 아니라 sr, 11.227)
rate-consec   = 3             #  연속 이만큼 넘으면 런을 정상 마감
rate-cooldown = 600           #  마감 뒤 재기동까지 쉬는 시간 [초]
rate-stop-limit = 3           #  rate-window 안에 이만큼 마감하면 standby
rate-window   = 7200          #  [초]
daq-logdir    = /Data_ssd/LOG              # TCB/FADCDAQ/SADCDAQ_<run6>.log
daq-logdir-old = /scratch/DAQ_LOG/RAW_log  # logrotate 가 옮긴 곳 (11.169)
